<script>
(function(){
  const slides=[...document.querySelectorAll('.slide')];
  const C=326.73;
  let cur=-1,timers=[];
  const fmt=(v,d)=>v.toLocaleString('id-ID',{minimumFractionDigits:d,maximumFractionDigits:d});
  const T=(fn,ms)=>timers.push(setTimeout(fn,ms));

  function countUp(el){
    const to=parseFloat(el.dataset.count),d=+(el.dataset.dec||0),pre=el.dataset.pre||'',suf=el.dataset.suf||'',dur=+(el.dataset.dur||1400);
    const t0=performance.now();el._run=true;
    (function step(t){const p=Math.min(1,(t-t0)/dur),e=1-Math.pow(1-p,3);el.textContent=pre+fmt(to*e,d)+suf;if(p<1&&el._run)requestAnimationFrame(step)})(t0);
  }
  function runClock(el){
    const total=+el.dataset.clock,dur=+(el.dataset.dur||3000);
    T(()=>{const t0=performance.now();el._run=true;
      (function step(t){const p=Math.min(1,Math.max(0,(t-t0)/dur));const s=Math.round(total*p);
        el.textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
        if(p<1&&el._run)requestAnimationFrame(step)})(t0);
    },+(el.dataset.delay||0));
  }
  function enter(s){
    s.querySelectorAll('[data-count]').forEach(el=>T(()=>countUp(el),parseFloat(el.dataset.delay||0)*1000));
    s.querySelectorAll('[data-w]').forEach(el=>T(()=>{el.style.width=el.dataset.w+'%'},parseFloat(el.dataset.delay||0)*1000+150));
    s.querySelectorAll('.ring .fg').forEach(el=>T(()=>{el.style.strokeDashoffset=C*(1-parseFloat(el.dataset.p)/100)},300));
    s.querySelectorAll('[data-at]').forEach(el=>T(()=>el.classList.add('show'),+el.dataset.at));
    s.querySelectorAll('[data-hide-at]').forEach(el=>T(()=>el.classList.add('gone'),+el.dataset.hideAt));
    s.querySelectorAll('[data-clock]').forEach(runClock);
  }
  function reset(s){
    s.querySelectorAll('[data-count]').forEach(el=>{el._run=false;el.textContent=(el.dataset.pre||'')+fmt(0,+(el.dataset.dec||0))+(el.dataset.suf||'')});
    s.querySelectorAll('[data-w]').forEach(el=>{el.style.width='0'});
    s.querySelectorAll('.ring .fg').forEach(el=>{el.style.strokeDashoffset=C});
    s.querySelectorAll('[data-at]').forEach(el=>el.classList.remove('show'));
    s.querySelectorAll('[data-hide-at]').forEach(el=>el.classList.remove('gone'));
    s.querySelectorAll('[data-clock]').forEach(el=>{el._run=false;el.textContent='00:00'});
  }
  function go(n){
    n=Math.max(0,Math.min(slides.length-1,n));
    if(n===cur)return;
    timers.forEach(clearTimeout);timers=[];
    if(cur>=0){const prev=slides[cur];prev.classList.remove('active');setTimeout(()=>{if(!prev.classList.contains('active'))reset(prev)},600)}
    cur=n;const s=slides[cur];reset(s);s.classList.add('active');s.scrollTop=0;enter(s);
    document.getElementById('prog').style.width=((cur+1)/slides.length*100)+'%';
    document.getElementById('count').textContent=String(cur+1).padStart(2,'0')+' / '+String(slides.length).padStart(2,'0');
    document.getElementById('notes').innerHTML='<b>Notes · slide '+(cur+1)+'</b>'+(s.dataset.notes||'');
    try{history.replaceState(null,'','#'+(cur+1))}catch(e){}
  }
  let hinted=false;
  function nav(n){go(n);if(!hinted&&cur>0){hinted=true;setTimeout(()=>{document.getElementById('hint').style.opacity=0},1500)}}
  addEventListener('keydown',e=>{
    const k=e.key;
    if(['ArrowRight','ArrowDown','PageDown',' ','Enter'].includes(k)){e.preventDefault();nav(cur+1)}
    else if(['ArrowLeft','ArrowUp','PageUp','Backspace'].includes(k)){e.preventDefault();nav(cur-1)}
    else if(k==='Home')nav(0);
    else if(k==='End')nav(slides.length-1);
    else if(k==='f'||k==='F'){if(document.fullscreenElement)document.exitFullscreen();else document.documentElement.requestFullscreen&&document.documentElement.requestFullscreen().catch(()=>{})}
    else if(k==='n'||k==='N'){document.body.classList.toggle('show-notes')}
  });
  document.getElementById('next').onclick=()=>nav(cur+1);
  document.getElementById('prev').onclick=()=>nav(cur-1);
  let tx=null,ty=null;
  addEventListener('touchstart',e=>{tx=e.touches[0].clientX;ty=e.touches[0].clientY},{passive:true});
  addEventListener('touchend',e=>{if(tx===null)return;const dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy))nav(cur+(dx<0?1:-1));tx=null});
  const start=(parseInt(location.hash.slice(1),10)||1)-1;
  go(start);

  // background network
  const c=document.getElementById('bg'),x=c.getContext('2d');
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W,H,P=[],dpr=1,D=150;
  function rs(){dpr=Math.min(2,devicePixelRatio||1);W=c.width=innerWidth*dpr;H=c.height=innerHeight*dpr;c.style.width=innerWidth+'px';c.style.height=innerHeight+'px';D=150*dpr;
    const n=Math.round(Math.min(70,innerWidth*innerHeight/22000));
    P=Array.from({length:n},()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.3*dpr,vy:(Math.random()-.5)*.3*dpr,o:Math.random()<.5}))}
  rs();addEventListener('resize',rs);
  (function f(){
    x.clearRect(0,0,W,H);
    for(const p of P){p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1}
    x.lineWidth=dpr;
    for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++){const a=P[i],b=P[j],d=Math.hypot(a.x-b.x,a.y-b.y);if(d<D){x.strokeStyle='rgba(140,150,220,'+((1-d/D)*.18)+')';x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke()}}
    for(const p of P){x.fillStyle=p.o?'rgba(245,146,62,.7)':'rgba(115,129,255,.7)';x.beginPath();x.arc(p.x,p.y,1.6*dpr,0,7);x.fill()}
    if(!reduce)requestAnimationFrame(f);
  })();
})();
</script>
